pageType: content
background:
  type: solid
  color: "$paper"
elements:
  # ================= 页眉 =================
  - elementId: kicker
    elementType: text
    bounds: [64, 52, 820, 18]
    content:
      fontSize: 12
      bold: true
      color: "$orange"
      letterSpacing: 3
      wrap: false
      text: MAPAOPAO · 马跑跑 —— 打卡偏差到课表落地的 AI 决策链路
  - elementId: title
    elementType: text
    bounds: [64, 80, 820, 62]
    content:
      fontSize: 46
      bold: true
      color: "$ink"
      wrap: false
