  - elementId: base-title-l
    elementType: text
    bounds: [104, 228, 420, 26]
    content:
      fontSize: 17
      bold: true
      color: "#FFFFFF"
      wrap: false
      text: 打卡触发 · 规则判定
  - elementId: base-sub-l
    elementType: text
    bounds: [104, 258, 420, 20]
    content:
      fontSize: 12
      color: "$faint"
      wrap: false
      text: 今日卡填实际公里数 · 超额 >110% 或不足 <50% 才触发
  - elementId: base-arrow
    elementType: line
    bounds: [548, 260, 112, 4]
    viewBox: [112, 4]
    points: "0,2 112,2"
    arrow: [null, arrow]
    border: {style: solid, width: 2, color: "$orange"}
  - elementId: base-arrow-label
    elementType: text
