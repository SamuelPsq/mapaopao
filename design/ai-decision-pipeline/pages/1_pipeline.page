    fill: {type: solid, color: "$orange"}
  - elementId: s1d-chip-num
    elementType: text
    bounds: [955, 466, 26, 26]
    content: {fontSize: 14, bold: true, color: "#FFFFFF", align: [center, middle], wrap: false, text: "4"}
  - elementId: s1d-name
    elementType: text
