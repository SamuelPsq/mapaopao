  - elementId: s1-fail-out
    elementType: text
    bounds: [604, 724, 612, 56]
    content:
      fontSize: 13.5
      color: "$ink"
      align: [left, middle]
      text: 整条作废 · 8 条规则模板文案自动顶上 · 用户无感知 · 埋点 source = template

  # ================= 关卡二 标题 =================
  - elementId: s2-num
    elementType: text
    bounds: [64, 854, 90, 66]
    content:
      fontSize: 54
      bold: true
      color: "$orange"
      wrap: false
      text: "02"
  - elementId: s2-title
    elementType: text
    bounds: [160, 862, 560, 34]
    content:
      fontSize: 26
      bold: true
      color: "$ink"
      wrap: false
