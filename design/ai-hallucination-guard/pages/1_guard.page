elements:
  # ================= 页眉 =================
  - elementId: kicker
    elementType: text
    bounds: [64, 52, 820, 18]
    content:
      fontSize: 12
      bold: true
      color: "$orange"
      letterSpacing: 3
      wrap: false
      text: MAPAOPAO · 马跑跑 —— AI 训练助手的模型安全设计
  - elementId: title
    elementType: text
    bounds: [64, 80, 820, 62]
    content:
      fontSize: 46
      bold: true
      color: "$ink"
      wrap: false
      text: AI 防幻觉设计
  - elementId: head-tag
    elementType: text
    bounds: [884, 62, 332, 54]
    content:
      fontSize: 11
      color: "$muted"
